#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>
/ {
    behaviors {
        combo_ht: combo_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };
    /* Read-only during the boot-load, global-save-failure and generic-write
     * groups, so no write of their own marks the cache. */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";
        combo_default_d {
            slot = <5>;
            key-positions = <2 3>;
            bindings = <&kp D>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <&kp A &kp A &kp A &kp A &kp E &kp F &kp G &kp H
                        &kp I &kp J &kp K &kp L &kp M &kp N &kp O &kp P &kp Q &mo 1
                        &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT
                        &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT &kp LSHFT>;
        };
        alternate_layer {
            bindings = <&trans &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans &trans &trans &trans
                        &trans &trans &trans &trans &trans &trans &trans &trans>;
        };
    };
};
&kscan {
    /* Keep the original two columns: (1,1) is still position3. Extend rows
     * so every binding and reentrant test position belongs to the matrix. */
    rows = <17>;
    columns = <2>;
    events = <ZMK_MOCK_PRESS(1,1,10) ZMK_MOCK_RELEASE(1,1,30000)>;
};
